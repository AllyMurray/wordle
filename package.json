{
  "name": "gamehub",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "homepage": "https://allymurray.github.io/gamehub/",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/version-service-worker.mjs",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:cross-browser": "playwright test --project=firefox --project=webkit --project=mobile-chrome --project=mobile-webkit",
    "test:e2e:pwa": "playwright test --project=pwa-upgrade",
    "test:e2e:visual": "playwright test --project=visual-chromium",
    "test:e2e:all": "playwright test",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "peerjs": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fast-check": "^4.9.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "peer": "^1.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  }
}
